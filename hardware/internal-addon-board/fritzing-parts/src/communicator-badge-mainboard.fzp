    <schematicView><p layer="schematic" svgId="connector9pin" terminalId="connector9terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector9pin"/><p layer="copper1" svgId="connector9pin"/></pcbView>
   </views>
  </connector>
 </connectors>
 <buses>
  <bus id="3v3"><nodeMember connectorId="connector0"/><nodeMember connectorId="connector6"/></bus>
  <bus id="gnd"><nodeMember connectorId="connector1"/><nodeMember connectorId="connector9"/></bus>
 </buses>
