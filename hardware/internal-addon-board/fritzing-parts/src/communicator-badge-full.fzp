   <views>
    <breadboardView><p layer="breadboard" svgId="connector4pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector4pin" terminalId="connector4terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector4pin"/><p layer="copper1" svgId="connector4pin"/></pcbView>
