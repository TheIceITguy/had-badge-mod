    <schematicView><p layer="schematic" svgId="connector7pin" terminalId="connector7terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector7pin"/><p layer="copper1" svgId="connector7pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector8" name="J6-3 IO12" type="female">
   <description>ESP32-S3 GPIO12, UART RX into badge (from GPS TX)</description>
   <views>
