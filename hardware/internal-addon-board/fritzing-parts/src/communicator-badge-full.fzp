    <schematicView><p layer="schematic" svgId="connector8pin" terminalId="connector8terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector8pin"/><p layer="copper1" svgId="connector8pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector9" name="J6-4 GND" type="female">
